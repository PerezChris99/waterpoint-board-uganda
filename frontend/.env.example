# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Random string, 32+ characters, used to sign session JWTs.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-32-character-or-longer-secret"

# Public site URL used for metadata, sitemap, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL="https://waterpointboarduganda.vercel.app"

# --- Optional: escalation notifications (Phase 22) ---
# Without these, sendNotification() safely no-ops (logs instead of sending) — the app works
# fine with none of this configured, this only enables real email delivery. See DEPLOYMENT.md.
# RESEND_API_KEY="re_..."
# NOTIFICATIONS_FROM_EMAIL="notifications@yourdomain.example"
# Shared secret required by /api/cron/escalations — without it, that route always returns 401.
# CRON_SECRET="replace-with-a-random-secret"

# --- Optional: SMS + USSD (Phase 23) ---
# Without these, sendSms() safely no-ops (logs instead of sending). POST /api/ussd works
# regardless (it's an inbound webhook, not outbound), it just won't be reachable by real phones
# until you configure an Africa's Talking USSD channel to point at it.
# AFRICAS_TALKING_API_KEY="..."
# AFRICAS_TALKING_USERNAME="..."
# AFRICAS_TALKING_SENDER_ID="..."


