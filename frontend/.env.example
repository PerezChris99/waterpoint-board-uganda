# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Random string, 32+ characters, used to sign session JWTs.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-32-character-or-longer-secret"

# Public site URL used for metadata, sitemap, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL="https://waterpointboarduganda.vercel.app"

# --- Required for `npm run db:seed`: your own private admin login ---
# The seed script refuses to run without these so the admin login is never a hardcoded,
# publicly-known credential. Choose your own real email/password here — never commit them.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-private-password"
# SEED_ADMIN_NAME="Your Name"

# Optional: also gives you one real, working caretaker/member login (for testing every role).
# Every other seeded caretaker/member gets a random, undisclosed password instead.
# SEED_CARETAKER_EMAIL="you+caretaker@example.com"
# SEED_CARETAKER_PASSWORD="replace-with-a-strong-private-password"
# SEED_MEMBER_EMAIL="you+member@example.com"
# SEED_MEMBER_PASSWORD="replace-with-a-strong-private-password"

# --- Optional: escalation notifications (Phase 22) ---
# Without these, sendNotification() safely no-ops (logs instead of sending) — the app works
# fine with none of this configured, this only enables real email delivery. See DEPLOYMENT.md.
# RESEND_API_KEY="re_..."
# NOTIFICATIONS_FROM_EMAIL="notifications@yourdomain.example"
# Shared secret required by /api/cron/escalations — without it, that route always returns 401.
# CRON_SECRET="replace-with-a-random-secret"

# --- Optional: SMS + USSD (Phase 23) ---
# Without these, sendSms() safely no-ops (logs instead of sending). POST /api/ussd works
# regardless (it's an inbound webhook, not outbound), it just won't be reachable by real phones
# until you configure an Africa's Talking USSD channel to point at it.
# AFRICAS_TALKING_API_KEY="..."
# AFRICAS_TALKING_USERNAME="..."
# AFRICAS_TALKING_SENDER_ID="..."

# --- Optional: shared rate limiting (Phase 25) ---
# Without these, rateLimit() falls back to an in-memory limiter (fine for a single instance,
# not shared across multiple serverless instances). Set both to switch to Upstash Redis.
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."


