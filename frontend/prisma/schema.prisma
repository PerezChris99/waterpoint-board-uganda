// WaterPoint Board Uganda — Prisma schema
// Postgres-only (Neon in production). Uses `prisma db push` instead of migration
// history: this is a deliberate simplification for a demo project with fixed seed
// data — see docs/ARCHITECTURE.md for the rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CARETAKER
  MEMBER
}

// A managing entity (district local government rural water unit, NWSC rural unit, NGO, etc.)
// that owns a subset of water points/users. Nullable on User/WaterPoint by design: rows with
// no organization are treated as platform-wide/demo data visible to a super-admin (an ADMIN
// with organizationId == null). This keeps the model additive and non-breaking.
enum OrganizationType {
  DISTRICT_LOCAL_GOVERNMENT
  NWSC_RURAL_UNIT
  NGO
  OTHER
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  type         OrganizationType
  contactEmail String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        User[]
  waterPoints  WaterPoint[]
}

enum WaterPointType {
  BOREHOLE
  SHALLOW_WELL
  PROTECTED_SPRING
  TAP_STAND
  RAINWATER_HARVESTING
}

enum WaterPointStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  REPORTED_UNAVAILABLE
  UNDER_MAINTENANCE
  NEEDS_VERIFICATION
}

// How a WaterPoint's current status/data was last verified (data provenance, not a quality certification).
enum VerificationMethod {
  FIELD_VISIT
  COMMUNITY_REPORT
  DISTRICT_SURVEY
  CARETAKER_UPDATE
  ADMIN_OVERRIDE
  SELF_REPORTED
  // Bulk-imported from a third-party open dataset (e.g. the Water Point Data Exchange) rather
  // than collected directly by this platform or its users.
  EXTERNAL_DATASET
}

enum ReportIssueType {
  NO_WATER
  LOW_PRESSURE
  CONTAMINATION_CONCERN
  PHYSICAL_DAMAGE
  VANDALISM
  OTHER
}

enum ReportStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// Anonymous report submissions start PENDING_REVIEW and are hidden from public-facing surfaces
// (the water point detail page, public insights) until a caretaker/admin approves or rejects
// them. Authenticated submissions are auto-approved (the account is already a known identity).
enum ModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  passwordHash        String
  role                Role             @default(MEMBER)
  village             String?
  // E.164-ish phone number for SMS notifications (Phase 23) — optional since not every account
  // has one, and email remains the primary notification channel.
  phone               String?
  // Bumped on logout and on role changes so a previously-issued JWT (which embeds the value at
  // sign time) is rejected by requireRole() even though the token itself hasn't expired yet.
  tokenVersion        Int              @default(0)
  // Scopes an ADMIN/CARETAKER to a single managing Organization; null means platform-wide
  // access (super-admin) or unassociated demo data. See Organization above.
  organizationId      String?
  organization        Organization?    @relation(fields: [organizationId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  reports             Report[]         @relation("ReporterReports")
  caretakerOf         WaterPoint[]     @relation("Caretaker")
  verifiedWaterPoints WaterPoint[]     @relation("Verifier")
  maintenanceLogs     MaintenanceLog[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([organizationId])
}

model WaterPoint {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  type               WaterPointType
  village            String
  parish             String
  subCounty          String
  latitude           Float
  longitude          Float
  status             WaterPointStatus    @default(NEEDS_VERIFICATION)
  installedYear      Int?
  source             String
  description        String?
  lastVerifiedAt     DateTime?
  // Data provenance: how/by whom the current status was last confirmed. Never a water-quality
  // certification — see docs/DATA-METHODOLOGY.md.
  verificationMethod VerificationMethod?
  verifiedById       String?
  verifiedBy         User?               @relation("Verifier", fields: [verifiedById], references: [id])
  // Scopes this water point to a managing Organization; null means platform-wide/demo data.
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  caretakerId        String?
  caretaker          User?               @relation("Caretaker", fields: [caretakerId], references: [id])
  reports            Report[]
  maintenanceLogs    MaintenanceLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([village])
  @@index([caretakerId])
  @@index([verifiedById])
  @@index([organizationId])
  @@index([type])
}

model Report {
  id               String           @id @default(cuid())
  waterPointId     String
  waterPoint       WaterPoint       @relation(fields: [waterPointId], references: [id], onDelete: Cascade)
  reporterId       String?
  reporter         User?            @relation("ReporterReports", fields: [reporterId], references: [id])
  reporterName     String?
  issueType        ReportIssueType
  description      String
  status           ReportStatus     @default(OPEN)
  moderationStatus ModerationStatus @default(APPROVED)
  resolutionNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([waterPointId])
  @@index([status])
  @@index([moderationStatus])
  @@index([createdAt])
}

model MaintenanceLog {
  id           String     @id @default(cuid())
  waterPointId String
  waterPoint   WaterPoint @relation(fields: [waterPointId], references: [id], onDelete: Cascade)
  caretakerId  String
  caretaker    User       @relation(fields: [caretakerId], references: [id])
  action       String
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([waterPointId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
